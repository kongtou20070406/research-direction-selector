{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:rds-prediction-request:v1",
  "title": "rds-prediction-request",
  "description": "Offline value shape only. Runtime validators enforce bindings, bounded JSON, family separation and time relations. Locators and hashes do not verify bytes or authorize execution.",
  "type": "object",
  "required": [
    "schema",
    "model",
    "snapshot",
    "candidates",
    "context",
    "versions",
    "provenance",
    "issued_at",
    "expires_at",
    "timeout_seconds"
  ],
  "properties": {
    "schema": {
      "const": "rds-prediction-request-v1"
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "parameters": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    },
    "context": {
      "type": "object"
    },
    "versions": {
      "type": "object",
      "required": [
        "engine",
        "features",
        "policy"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "features": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "locator",
          "sha256",
          "version"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "issued_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000.0
    },
    "expires_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000.0
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 30
    }
  },
  "additionalProperties": false
}
