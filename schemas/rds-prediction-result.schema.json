{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:rds-prediction-result:v1",
  "title": "rds-prediction-result",
  "description": "Offline value shape only. Runtime validators enforce bindings, bounded JSON, family separation and time relations. Locators and hashes do not verify bytes or authorize execution.",
  "type": "object",
  "required": [
    "schema",
    "request_sha256",
    "model",
    "snapshot_sha256",
    "status",
    "reason",
    "reason_code",
    "forecasts",
    "costs",
    "selection_effect",
    "evidence_status"
  ],
  "properties": {
    "schema": {
      "const": "rds-prediction-result-v1"
    },
    "request_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "SCORED",
        "ABSTAINED"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2048
    },
    "reason_code": {
      "enum": [
        "NONE",
        "INVALID",
        "TIMEOUT",
        "STALE",
        "UNAVAILABLE",
        "PROVIDER_ABSTAINED"
      ]
    },
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "score",
          "uncertainty"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "score": {
            "type": "number",
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "costs": {
      "type": "object",
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "status"
      ],
      "properties": {
        "wall_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "wall_seconds": {
                "type": "number"
              },
              "cpu_seconds": {
                "type": "number"
              }
            }
          },
          "else": {
            "anyOf": [
              {
                "properties": {
                  "wall_seconds": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "cpu_seconds": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "selection_effect": {
      "const": "NONE"
    },
    "evidence_status": {
      "const": "UNKNOWN"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ABSTAINED"
          }
        }
      },
      "then": {
        "properties": {
          "forecasts": {
            "maxItems": 0
          },
          "reason": {
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason_code": {
            "enum": [
              "INVALID",
              "TIMEOUT",
              "STALE",
              "UNAVAILABLE",
              "PROVIDER_ABSTAINED"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "model": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason_code": {
            "const": "NONE"
          },
          "forecasts": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code": {
            "enum": [
              "NONE",
              "TIMEOUT",
              "STALE",
              "UNAVAILABLE",
              "PROVIDER_ABSTAINED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "model": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
