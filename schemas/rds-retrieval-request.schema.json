{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:rds-retrieval-request:v1",
  "title": "rds-retrieval-request",
  "description": "Offline value shape only. Runtime validators enforce bindings, bounded JSON, family separation and time relations. Locators and hashes do not verify bytes or authorize execution.",
  "type": "object",
  "required": [
    "schema",
    "corpus",
    "model",
    "query",
    "top_k",
    "filters",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "rds-retrieval-request-v1"
    },
    "corpus": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "\\S"
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "filters": {
      "type": "object",
      "properties": {
        "problem_families": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "locator",
          "sha256",
          "version"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "additionalProperties": false
}
