{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:rds-retrieval-result:v1",
  "title": "rds-retrieval-result",
  "description": "Offline value shape only. Runtime validators enforce bindings, bounded JSON, family separation and time relations. Locators and hashes do not verify bytes or authorize execution.",
  "type": "object",
  "required": [
    "schema",
    "request_sha256",
    "corpus",
    "model",
    "status",
    "reason",
    "hits",
    "costs",
    "evidence_status"
  ],
  "properties": {
    "schema": {
      "const": "rds-retrieval-result-v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "PROPOSED",
        "UNAVAILABLE"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 2048
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "score",
          "relation_status",
          "provenance"
        ],
        "properties": {
          "artifact": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "score": {
            "type": "number",
            "minimum": -1000000000000000.0,
            "maximum": 1000000000000000.0
          },
          "relation_status": {
            "const": "PROPOSED"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "locator",
                "sha256",
                "version"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "costs": {
      "type": "object",
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "status"
      ],
      "properties": {
        "wall_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "wall_seconds": {
                "type": "number"
              },
              "cpu_seconds": {
                "type": "number"
              }
            }
          },
          "else": {
            "anyOf": [
              {
                "properties": {
                  "wall_seconds": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "cpu_seconds": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "evidence_status": {
      "const": "UNKNOWN"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNAVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 1,
            "pattern": "\\S"
          },
          "hits": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
