{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rds:rds-transition-dataset:v1",
  "title": "rds-transition-dataset",
  "description": "Offline value shape only. Runtime validators enforce bindings, bounded JSON, family separation and time relations. Locators and hashes do not verify bytes or authorize execution.",
  "type": "object",
  "required": [
    "schema",
    "dataset",
    "versions",
    "splits",
    "transitions",
    "evidence_status"
  ],
  "properties": {
    "schema": {
      "const": "rds-transition-dataset-v1"
    },
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "engine",
        "features",
        "policy",
        "model"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "features": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "splits": {
      "type": "object",
      "required": [
        "train",
        "confirmation"
      ],
      "properties": {
        "train": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "confirmation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "problem_family",
          "split",
          "decision_input",
          "forecasts",
          "selection",
          "observation",
          "before",
          "action",
          "after",
          "run_status",
          "failure",
          "costs",
          "versions",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "problem_family": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "maxLength": 128
          },
          "split": {
            "enum": [
              "train",
              "confirmation"
            ]
          },
          "decision_input": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "forecasts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 128
          },
          "selection": {
            "type": "object",
            "required": [
              "candidate_id",
              "receipt"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "receipt": {
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "observation": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {
            "type": "object",
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "action": {
            "type": "object",
            "required": [
              "candidate_id",
              "parameters"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "maxLength": 128
              },
              "parameters": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "version",
                  "sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "run_status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT",
              "CANCELLED",
              "INTERRUPTED"
            ]
          },
          "failure": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "reason",
                  "receipt"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "\\S"
                  },
                  "receipt": {
                    "type": "object",
                    "required": [
                      "id",
                      "version",
                      "sha256"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                        "maxLength": 128
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "\\S"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "costs": {
            "type": "object",
            "required": [
              "wall_seconds",
              "cpu_seconds",
              "status"
            ],
            "properties": {
              "wall_seconds": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000000.0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cpu_seconds": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000000000.0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "KNOWN",
                  "UNKNOWN"
                ]
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "KNOWN"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "wall_seconds": {
                      "type": "number"
                    },
                    "cpu_seconds": {
                      "type": "number"
                    }
                  }
                },
                "else": {
                  "anyOf": [
                    {
                      "properties": {
                        "wall_seconds": {
                          "type": "null"
                        }
                      }
                    },
                    {
                      "properties": {
                        "cpu_seconds": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "versions": {
            "type": "object",
            "required": [
              "engine",
              "features",
              "policy",
              "model"
            ],
            "properties": {
              "engine": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "features": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "policy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "locator",
                "sha256",
                "version"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "maxLength": 128
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "run_status": {
                  "const": "SUCCEEDED"
                }
              }
            },
            "then": {
              "properties": {
                "failure": {
                  "type": "null"
                },
                "observation": {
                  "type": "object",
                  "required": [
                    "id",
                    "version",
                    "sha256"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                      "maxLength": 128
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "\\S"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "after": {
                  "type": "object",
                  "required": [
                    "id",
                    "version",
                    "sha256"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                      "maxLength": 128
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "\\S"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "else": {
              "properties": {
                "failure": {
                  "type": "object"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "evidence_status": {
      "const": "UNKNOWN"
    }
  },
  "additionalProperties": false
}
